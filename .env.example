AUTH_SECRET=your_nextauth_secret_here # Generate with `npx auth secret`
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret
SUPER_USER_EMAIL=admin@example.com
SUPER_USER_PASSWORD=secure_password_here

# Optional intervention calibration / persistence
# Census now requires a registered API key; CDC PLACES and Europe PMC do not.
CENSUS_API_KEY=
# Local default: .fieldwork/interventions.sqlite in the project directory.
# Vercel default: writable /tmp/.fieldwork/interventions.sqlite (temporary, instance-local).
# No override is required on Vercel. Never point it at /var/task.
# A custom path overrides the default; it does not make Vercel storage permanent.
# FIELDWORK_DB_PATH=/absolute/path/to/interventions.sqlite
